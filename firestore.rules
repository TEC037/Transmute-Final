rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Habits are synced through the /api/sync proxy, which stamps `ownerUid`
    // from the verified ID token. Direct client access is gated on that owner.
    match /habits/{habitId} {
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
  }
}
