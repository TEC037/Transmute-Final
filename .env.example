# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MODEL_PROVIDER: 'auto' (default) | 'gemini' | 'openrouter' | 'cloudflare'
# - auto: uses the first provider whose credentials are present:
#   OpenRouter > Cloudflare > Gemini.
MODEL_PROVIDER="auto"

# Gemini model override (default: gemini-3.6-flash)
GEMINI_MODEL="gemini-3.6-flash"

# OpenRouter (many open models: DeepSeek, Llama, Qwen...).
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_MODEL="deepseek/deepseek-chat-v3-0324"

# Cloudflare Workers AI (free tier ~10k neurons/day).
# CLOUDFLARE_API_TOKEN: API token with "Workers AI: Run" permission.
# CLOUDFLARE_ACCOUNT_ID: your account id (dashboard.cloudflare.com).
CLOUDFLARE_API_TOKEN="MY_CLOUDFLARE_API_TOKEN"
CLOUDFLARE_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"
CLOUDFLARE_MODEL="@cf/meta/llama-3.3-70b-instruct-fp8-fast"

# ASSISTANT_DAILY_LIMIT: max assistant calls per user per day (default: 30).
ASSISTANT_DAILY_LIMIT="30"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
